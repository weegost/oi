# 複製本檔為 .env 後填入。.env 不會被提交到 Git。

# --- Gemini（到 https://aistudio.google.com 申請）---
GEMINI_API_KEY=
# 模型名稱可依 AI Studio 目前提供的 Flash 系列調整
GEMINI_MODEL=gemini-3.5-flash
# 主模型忙碌時依序改用（JSON 陣列）
GEMINI_FALLBACK_MODELS=["gemini-3.8-flash","gemini-3.5-flash-lite"]
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- PostgreSQL（docker compose 使用）---
POSTGRES_USER=bizpilot
POSTGRES_PASSWORD=bizpilot
POSTGRES_DB=bizpilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://bizpilot:bizpilot@localhost:5432/bizpilot

# --- 前端呼叫後端的位址 ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
